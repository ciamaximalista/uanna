[Unit]
Description=Uanna instance
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/uanna
Environment=UANNA_HTTP_HOST=127.0.0.1
Environment=UANNA_HTTP_PORT=8001
ExecStart=/var/www/html/uanna/oannes/bin/start-httpd.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
